use guix
layout python3
export CC="clang"
# Guix profile with musl shadows GCC's internal stdarg.h via C_INCLUDE_PATH,
# breaking native-C crate builds (zstd-sys, ring). Removing musl from the
# profile may solve this at the source.
export C_INCLUDE_PATH=/run/current-system/profile/include
export CPLUS_INCLUDE_PATH=/run/current-system/profile/include
export LD_LIBRARY_PATH=$LIBRARY_PATH
export PATH=$PATH:$HOME/.cargo/bin
